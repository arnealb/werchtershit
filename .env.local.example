# Spotify (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
# Local dev: http://127.0.0.1:3000/api/spotify/callback
# Production: https://<your-app>.vercel.app/api/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# OpenAI — powers the Smart Prep track ranking
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# setlist.fm (optional but recommended) — adds "actually played live recently"
# data to Smart Prep. Free key: https://www.setlist.fm/settings/api
SETLISTFM_API_KEY=your_setlistfm_key

# Supabase (Project Settings → API). Optional locally (falls back to data/lineup.json),
# required on Vercel. The service role key is server-only — never expose it client-side.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
