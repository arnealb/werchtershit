# Spotify (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
# Local dev: http://127.0.0.1:3000/api/spotify/callback
# Production: https://<your-app>.vercel.app/api/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# AI provider — set GEMINI_API_KEY (free tier, aistudio.google.com) and all AI
# features (Smart Prep, event import, event search) run on Gemini.
# Without it, OpenAI is used as fallback.
GEMINI_API_KEY=your_gemini_key
# GEMINI_MODEL=gemini-2.5-flash

# OpenAI — fallback provider when GEMINI_API_KEY is not set
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EXTRACT_MODEL=gpt-4o

# setlist.fm (optional but recommended) — adds "actually played live recently"
# data to Smart Prep. Free key: https://www.setlist.fm/settings/api
SETLISTFM_API_KEY=your_setlistfm_key

# Supabase (Project Settings → API). Optional locally (falls back to data/lineup.json),
# required on Vercel. The service role key is server-only — never expose it client-side.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
